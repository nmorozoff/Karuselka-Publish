# Макс-бот — отчёты после публикации каруселей
# cp max.env.example max.env.local
# или symlink из «Посты EMDR»:
#   ln -sf ../../Посты\ EMDR/posts-emdr-memory/max.env.local publish-memory/max.env.local

MAX_BOT_TOKEN=
# Личка с ботом (куда приходят отчёты). Можно MAX_PREVIEW_CHAT_ID из Посты EMDR.
MAX_NOTIFY_CHAT_ID=
# MAX_PREVIEW_CHAT_ID=   # alias, если symlink на posts-emdr-memory/max.env.local
MAX_API_INSECURE_TLS=true
