# Zernio — Instagram + TikTok
# cp zernio.env.example zernio.env.local

PUBLISH_MODE=grok_hook
EXPECTED_IMAGE_SLIDES=6
TIKTOK_MAX_HASHTAGS=4

# pair1 (default)
ZERNIO_API_KEY=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_TIKTOK_ACCOUNT_ID=

# pair2 (optional — если отдельный аккаунт/ключ)
ZERNIO_PAIR2_API_KEY=

# pair3: может быть один общий ключ или разные для IG и TT
ZERNIO_PAIR3_API_KEY=
ZERNIO_PAIR3_INSTAGRAM_API_KEY=
ZERNIO_PAIR3_TIKTOK_API_KEY=
